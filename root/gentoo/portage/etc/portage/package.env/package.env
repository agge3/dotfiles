sys-libs/glibc debugsyms installsources
sys-libs/glibc glibc-no-strlen

# mpd failing to compiler with gcc -> compile with clang
media-sound/mpd compiler-clang

#
# Enable ccache
#

# Compilers
sys-devel/gcc enable-ccache.conf
llvm-core/clang enable-ccache.conf
llvm-core/llvm enable-ccache.conf
llvm-core/lld enable-ccache.conf
dev-lang/rust enable-ccache.conf

# Large applications
www-client/firefox enable-ccache.conf

