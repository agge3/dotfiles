## Gentoo kernel
sys-kernel/gentoo-kernel
# Make installkernel auto-run grub-mkconfig and build dracut initramfs
sys-kernel/installkernel grub dracut

## NTP server for system time
net-misc/chrony -nss nettle # use gnu nettle, not mozilla nss (nettle is lighter?)

# GCC
sys-devel/gcc sanitize

# YouTube recording
media-video/ffmpeg vaapi vdpau opengl openh264 x264 vulkan

# Display manager
gui-libs/greetd man

# Emulators
app-emulation/bochs gdb -smp

# LXC (jails)
app-containers/lxc 

# C/CXX
dev-util/ccache doc

# SQL
#dev-db/postgresql PYTHON_SINGLE_TARGET: python3_12 python3_11 
dev-db/postgresql
# Python bindings for PostgreSGL
#dev-python/psycopg PYTHON_TARGETS: python3_12 python3_11
dev-python/psycopg

## LLVM
# move sys-devel/llvm llvm-core/llvm
llvm-core/llvm
# move sys-devel/lld llvm-core/lld
llvm-core/lld

