x11-wm/awesome dbus doc LUA_SINGLE_TARGET: lua5-4 -lua5-1

# Python libraries
dev-python/django doc sqlite

## OpenGL DevKit
media-libs/libsdl opengl # sdl devkit w/ opengl
media-libs/libsdl2 opengl

# Gentoo development
dev-util/pkgdev doc

## Screen and webcam capture (Wayland/OBS)
sys-apps/xdg-desktop-portal screencast
media-video/obs-studio pipewire vlc

## Java
dev-java/openjdk javafx # include javafx
dev-java/openjdk-bin javafx

## Net
net-analyzer/tcpdump suid

## Editors
app-editors/emacs 

## Sound
media-sound/pulseaudio daemon jack glib
media-sound/pulseaudio-daemon jack
media-video/pipewire extra	# for ffmpeg

